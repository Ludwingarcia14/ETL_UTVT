# Carpetas generadas por Visual Studio / SSIS
bin/
obj/
.vs/

# Archivos de usuario y respaldo (config local, no se versiona)
*.user
*.bak
*.dtproj.bak

# Logs y temporales
*.log
*.tmp

# Artefactos generados en cada corrida del paquete
data/errores/*
!data/errores/.gitkeep
data/procesados/*
!data/procesados/.gitkeep
